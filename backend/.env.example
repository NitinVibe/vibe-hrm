APP_NAME=Vibe HRM
APP_ENV=development
DEBUG=false
ENABLE_DOCS=false

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/hrm_db
DB_POOL_CLASS=queue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=30000
DB_SSL_REQUIRED=false

# Security & Authentication
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS & Origins
CORS_ORIGINS=http://localhost:5173
# Optional regex for Vercel preview deployments (e.g. ^https://.*\.vercel\.app$)
CORS_ORIGIN_REGEX=

# Login Abuse Protection (Rate Limiting)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# Optional distributed storage for serverless (Upstash Redis or standard Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
